<?php

/**
 * @file
 * Provides install functionality for the Orbit Banner module.
 */

declare(strict_types=1);

use Drupal\Core\Config\FileStorage;
use Drupal\Core\Utility\UpdateException;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\orbit_banner\BannerConditions;

/**
 * Implements hook_install().
 */
function orbit_banner_install(): void {
  _orbit_banner_apply_page_banner_field_group();
}

/**
 * Returns the banner form display components, keyed by field name.
 */
function _orbit_banner_page_banner_components(): array {
  $media_library_widget = [
    'type' => 'media_library_widget',
    'region' => 'content',
    'settings' => [
      'media_types' => [],
    ],
    'third_party_settings' => [
      'media_library_edit' => [
        'show_edit' => TRUE,
        'edit_form_mode' => 'default',
      ],
    ],
  ];

  return [
    // Help tab.
    'field_orbit_banner_help' => [
      'type' => 'markup',
      'weight' => 0,
      'region' => 'content',
      'settings' => [],
      'third_party_settings' => [],
    ],

    // Content tab.
    'field_orbit_banner_title' => [
      'type' => 'string_textfield',
      'weight' => 11,
      'region' => 'content',
      'settings' => [
        'size' => 60,
        'placeholder' => '',
      ],
      'third_party_settings' => [],
    ],
    'field_orbit_banner_text' => [
      'type' => 'text_textarea',
      'weight' => 12,
      'region' => 'content',
      'settings' => [
        'rows' => 5,
        'placeholder' => '',
      ],
      'third_party_settings' => [],
    ],
    'field_orbit_banner_image' => ['weight' => 13] + $media_library_widget,
    'field_orbit_banner_video' => ['weight' => 14] + $media_library_widget,

    // Settings tab.
    'field_orbit_banner_effect' => [
      'type' => 'options_select',
      'weight' => 20,
      'region' => 'content',
      'settings' => [],
      // Only shown once two or more images are selected.
      'third_party_settings' => [
        'conditional_fields' => BannerConditions::effectFieldSettings(),
      ],
    ],
    'field_orbit_banner_size' => [
      'type' => 'options_select',
      'weight' => 21,
      'region' => 'content',
      'settings' => [],
      'third_party_settings' => [],
    ],
    'field_orbit_banner_parallax' => [
      'type' => 'boolean_checkbox',
      'weight' => 22,
      'region' => 'content',
      'settings' => [
        'display_label' => TRUE,
      ],
      'third_party_settings' => [],
    ],
    'field_orbit_banner_colour' => [
      'type' => 'color_field_widget_box',
      'weight' => 23,
      'region' => 'content',
      'settings' => [
        'default_colors' => "#ac725e,#d06b64,#f83a22,#fa573c,#ff7537,#ffad46\n#42d692,#16a765,#7bd148,#b3dc6c,#fbe983\n#92e1c0,#9fe1e7,#9fc6e7,#4986e7,#9a9cff\n#b99aff,#c2c2c2,#cabdbf,#cca6ac,#f691b2\n#cd74e6,#a47ae2",
      ],
      'third_party_settings' => [],
    ],
  ];
}

/**
 * Returns the tabs of the Banner group, in display order.
 *
 * @return array[]
 *   Tab definitions keyed by field group name, each with a 'label' and the
 *   'fields' it contains.
 */
function _orbit_banner_page_banner_tabs(): array {
  return [
    'group_banner_content' => [
      'label' => 'Content',
      'fields' => [
        'field_orbit_banner_title',
        'field_orbit_banner_text',
        'field_orbit_banner_image',
        'field_orbit_banner_video',
      ],
    ],
    'group_banner_settings' => [
      'label' => 'Settings',
      'fields' => [
        'field_orbit_banner_effect',
        'field_orbit_banner_size',
        'field_orbit_banner_parallax',
        'field_orbit_banner_colour',
      ],
    ],
    'group_banner_help' => [
      'label' => 'Help',
      'fields' => [
        'field_orbit_banner_help',
      ],
    ],
  ];
}

/**
 * Adds the Banner field group to the Page node form display.
 *
 * The Banner tab holds a horizontal tab set splitting the fields by purpose:
 *
 * @code
 * group_tabs (vertical tabs, shared with other modules)
 * └── group_banner ............................. tab, "Banner"
 *     └── group_banner_tabs ................... horizontal tabs
 *         ├── group_banner_content ............ tab, "Content"
 *         ├── group_banner_settings ........... tab, "Settings"
 *         └── group_banner_help ............... tab, "Help"
 * @endcode
 *
 * @see _orbit_banner_page_banner_tabs()
 */
function _orbit_banner_apply_page_banner_field_group(): void {
  if (!\Drupal::moduleHandler()->moduleExists('field_group')) {
    return;
  }

  $form_display = \Drupal::service('entity_display.repository')
    ->getFormDisplay('node', 'basic_page', 'default');

  $field_definitions = \Drupal::service('entity_field.manager')
    ->getFieldDefinitions('node', 'basic_page');

  foreach (_orbit_banner_page_banner_components() as $field_name => $component) {
    if (isset($field_definitions[$field_name])) {
      $form_display->setComponent($field_name, $component);
    }
  }

  // Only fields that actually exist may be listed as group children.
  $exists = static fn (array $names): array => array_values(array_filter(
    $names,
    static fn (string $name): bool => isset($field_definitions[$name])
  ));

  $tab_defaults = [
    'region' => 'content',
    'format_type' => 'tab',
    'format_settings' => [
      'classes' => '',
      'show_empty_fields' => FALSE,
      'id' => '',
      'label_as_html' => FALSE,
      'formatter' => 'closed',
      'description' => '',
      'required_fields' => TRUE,
    ],
  ];

  $tabs = _orbit_banner_page_banner_tabs();
  $weight = 0;

  foreach ($tabs as $group_name => $tab) {
    $form_display->setThirdPartySetting('field_group', $group_name, [
      'children' => $exists($tab['fields']),
      'label' => $tab['label'],
      'parent_name' => 'group_banner_tabs',
      'weight' => $weight++,
    ] + $tab_defaults);
  }

  $form_display->setThirdPartySetting('field_group', 'group_banner_tabs', [
    'children' => array_keys($tabs),
    'label' => 'Banner tabs',
    'region' => 'content',
    'parent_name' => 'group_banner',
    'weight' => 0,
    'format_type' => 'tabs',
    'format_settings' => [
      'classes' => '',
      'show_empty_fields' => FALSE,
      'id' => '',
      'label_as_html' => FALSE,
      'direction' => 'horizontal',
      'width_breakpoint' => 640,
    ],
  ]);

  // Every banner field now lives on one of the nested tabs.
  $form_display->setThirdPartySetting('field_group', 'group_banner', [
    'children' => ['group_banner_tabs'],
    'label' => 'Banner',
    'parent_name' => 'group_tabs',
    'weight' => 6,
  ] + $tab_defaults);

  _orbit_banner_attach_to_tabs_group($form_display);
  _orbit_banner_sort_field_groups($form_display);

  $form_display->save();
}

/**
 * Reorders the field_group settings so every parent precedes its children.
 *
 * Field group decides which groups to hide by walking the groups once and
 * marking a parent as non-empty when it meets a child that has content, in
 * field_group_remove_empty_form_groups(). Beforehand,
 * field_group_remove_empty_form_revert_groups() reverses the group order, so
 * the walk only reaches a child before its parent when the stored order runs
 * parent first.
 *
 * Groups created by the field_group UI happen to be stored that way. Ones
 * added by an install hook are appended in call order, so a nested group added
 * after its parent would never mark that parent as non-empty, and the parent
 * would be given '#access' => FALSE and vanish from the form.
 *
 * @see field_group_remove_empty_form_revert_groups()
 * @see field_group_remove_empty_form_groups()
 */
function _orbit_banner_sort_field_groups($form_display): void {
  $groups = $form_display->getThirdPartySettings('field_group');

  if (!$groups) {
    return;
  }

  $ordered = [];

  $append_children = function (string $parent) use (&$append_children, &$ordered, $groups): void {
    foreach ($groups as $name => $group) {
      if (($group['parent_name'] ?? '') === $parent && !isset($ordered[$name])) {
        $ordered[$name] = $group;
        $append_children($name);
      }
    }
  };
  $append_children('');

  // Keep anything whose parent is missing rather than dropping it.
  $ordered += $groups;

  if (array_keys($ordered) === array_keys($groups)) {
    return;
  }

  foreach (array_keys($groups) as $name) {
    $form_display->unsetThirdPartySetting('field_group', $name);
  }
  foreach ($ordered as $name => $group) {
    $form_display->setThirdPartySetting('field_group', $name, $group);
  }
}

/**
 * Adds the Banner tab to the shared vertical tabs group.
 *
 * This group is not owned by this module — sibling modules put their own tabs
 * in it — and field_group nests groups by the parent's 'children' list, not by
 * each child's 'parent_name'. Overwriting that list would therefore drop every
 * other tab out of the tab set, so the Banner tab is merged into whatever is
 * already there.
 */
function _orbit_banner_attach_to_tabs_group($form_display): void {
  $group_tabs = $form_display->getThirdPartySetting('field_group', 'group_tabs') ?: [
    'children' => [],
    'label' => 'Tabs',
    'region' => 'content',
    'parent_name' => '',
    'weight' => 7,
    'format_type' => 'tabs',
    'format_settings' => [
      'classes' => '',
      'show_empty_fields' => FALSE,
      'id' => '',
      'label_as_html' => FALSE,
      'direction' => 'vertical',
      'width_breakpoint' => 640,
    ],
  ];

  // Recover any sibling tab that a previous release of this hook orphaned by
  // replacing the children list outright.
  foreach ($form_display->getThirdPartySettings('field_group') as $name => $group) {
    if (($group['parent_name'] ?? '') === 'group_tabs') {
      $group_tabs['children'][] = $name;
    }
  }

  $group_tabs['children'] = array_values(array_unique($group_tabs['children']));

  $form_display->setThirdPartySetting('field_group', 'group_tabs', $group_tabs);
}

/**
 * Creates a field from this module's config/install directory, if missing.
 *
 * The entity storage handlers are used rather than Entity::create() so that
 * the stored representation of type specific settings is decoded the same way
 * the config system decodes it. Notably, list fields keep 'allowed_values' as
 * a value => label map in memory and only structure it on save, so passing the
 * structured record straight to create() would double encode it.
 */
function _orbit_banner_install_field(string $field_name, string $bundle = 'basic_page'): void {
  $source = \Drupal::service('extension.list.module')->getPath('orbit_banner') . '/config/install';
  $file_storage = new FileStorage($source);
  $entity_type_manager = \Drupal::entityTypeManager();

  if (!FieldStorageConfig::loadByName('node', $field_name)) {
    $record = $file_storage->read("field.storage.node.$field_name");

    if (!$record) {
      throw new UpdateException("Missing field storage config for $field_name.");
    }

    $entity_type_manager->getStorage('field_storage_config')
      ->createFromStorageRecord($record)
      ->save();
  }

  if (!FieldConfig::loadByName('node', $bundle, $field_name)) {
    $record = $file_storage->read("field.field.node.$bundle.$field_name");

    if (!$record) {
      throw new UpdateException("Missing field config for $field_name.");
    }

    $entity_type_manager->getStorage('field_config')
      ->createFromStorageRecord($record)
      ->save();
  }
}

/**
 * Allows multiple banner images and adds the effect and parallax fields.
 */
function orbit_banner_update_11001(): void {
  $image_storage = FieldStorageConfig::loadByName('node', 'field_orbit_banner_image');

  if ($image_storage && $image_storage->getCardinality() !== FieldStorageConfig::CARDINALITY_UNLIMITED) {
    $image_storage->setCardinality(FieldStorageConfig::CARDINALITY_UNLIMITED)->save();
  }

  _orbit_banner_install_field('field_orbit_banner_effect');
  _orbit_banner_install_field('field_orbit_banner_parallax');

  // Place the new fields on the Banner tab.
  _orbit_banner_apply_page_banner_field_group();
}

/**
 * Shows the transition effect field only when multiple images are selected.
 */
function orbit_banner_update_11002(): void {
  if (!\Drupal::moduleHandler()->moduleExists('conditional_fields')) {
    throw new UpdateException('The conditional_fields module must be installed before running this update.');
  }

  // Re-applying the components attaches the Conditional Fields dependency.
  _orbit_banner_apply_page_banner_field_group();
}

/**
 * Splits the Banner tab into horizontal Content, Settings and Help tabs.
 */
function orbit_banner_update_11003(): void {
  // Every banner field moves onto one of the nested tabs, and
  // _orbit_banner_apply_page_banner_field_group() already sets the Banner tab's
  // children to just the tab set, so no stale children can be left behind.
  _orbit_banner_apply_page_banner_field_group();
}
